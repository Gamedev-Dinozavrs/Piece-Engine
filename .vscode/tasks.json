{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Visual Studio 18 2026",
        "-A", "x64"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Configure the project"
    },
    {
      "label": "CMake Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build",
        "--config", "Debug"
      ],
      "group": {
        "kind": "build",
      },
      "dependsOn": ["CMake Configure", "Compile Shaders"],
      "problemMatcher": [],
      "detail": "Build the project"
    },
    {
      "label": "Compile Shaders",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\PieceLib\\src\\shaders\\compile_shaders.bat"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Compile Vulkan shader sources"
    },
    {
      "label": "Run PieceEditor",
      "type": "shell",
      "command": "${workspaceFolder}/build/PieceEditor/Debug/PieceEditor.exe",
      "group": {
        "kind": "build"
      },
      "dependsOn": "CMake Build",
      "problemMatcher": [],
      "detail": "Run the main executable"
    }
  ]
}